# Copy to .env (git-ignored) and fill in. Testnet only.
NEAR_NETWORK=testnet
NEAR_ACCOUNT_ID=your-account.testnet
# Full-access key of that account, in the form ed25519:<base58>
NEAR_PRIVATE_KEY=
NEAR_RPC_URL=https://test.rpc.fastnear.com

# Chain Signatures
MPC_CONTRACT=v1.signer-prod.testnet
MPC_ED25519_DOMAIN_ID=1
CA_PATH=gatepass-ca-v1

# The Gatepass contract. This one is live on testnet; replace it if you deploy your own.
GATEPASS_CONTRACT=gatepass-v2.gp-spike-47008742.testnet

# Optional: the model behind agent/agent.ts. Any OpenAI-compatible chat API
# with tool calling works. Leave the key empty to use the fixed-rule fallback.
AGENT_LLM_API_KEY=
AGENT_LLM_BASE_URL=https://cloud-api.near.ai/v1
AGENT_LLM_MODEL=z-ai/glm-5.3-flash
